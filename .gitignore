((venv_py312) ) samba_loks@Samba:/mnt/f/All_AboutProject/motor-health-edge-ai$ head -30 scripts/verify_v3_float_accuracy.py
import numpy as np
import tensorflow as tf

# 1. Load the model
interpreter = tf.lite.Interpreter(model_path="F:/All_AboutProject/motor-health-edge-ai/models/tflite/v3_float.tflite")
interpreter.allocate_tensors()

input_details = interpreter.get_input_details()
output_details = interpreter.get_output_details()

# 2. Create a fake "Healthy" window based on your CSV (50 samples, 6 channels)
window = np.zeros((50, 6), dtype=np.float32)
window[:, 0] = -0.8  # ax
window[:, 1] = 0.2   # ay
window[:, 2] = 10.5  # az
window[:, 3] = 180.0 # current
window[:, 4] = 5.97  # voltage
window[:, 5] = 306.0 # rpm

# 3. Normalize using your NORM_MEAN and NORM_STD (Replace these with real values from norm_params.h)
NORM_MEAN = np.array([-0.8, 0.2, 10.5, 180.0, 5.97, 306.0], dtype=np.float32)
NORM_STD = np.array([0.1, 0.1, 0.5, 5.0, 0.01, 10.0], dtype=np.float32)

window_norm = (window - NORM_MEAN) / NORM_STD

# 4. Reshape to what the model expects: (1, 6, 50)
# window_norm is (50, 6). Transpose to (6, 50) then add batch dim.
input_data = np.transpose(window_norm, (1, 0)) # (6, 50)
input_data = np.expand_dims(input_data, axis=0).astype(np.float32)
