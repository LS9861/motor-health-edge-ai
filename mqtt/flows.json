[
  {
    "id": "broker1",
    "type": "mqtt-broker",
    "name": "mosquitto",
    "broker": "192.168.1.100",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt-sub-state",
    "type": "mqtt in",
    "z": "flow1",
    "name": "state",
    "topic": "motor/health/state",
    "qos": "0",
    "datatype": "json",
    "broker": "broker1",
    "x": 160,
    "y": 120,
    "wires": [["uf-state"]]
  },
  {
    "id": "mqtt-sub-mode",
    "type": "mqtt in",
    "z": "flow1",
    "name": "mode",
    "topic": "motor/health/mode",
    "qos": "0",
    "datatype": "string",
    "broker": "broker1",
    "x": 160,
    "y": 180,
    "wires": [["ui-mode"]]
  },
  {
    "id": "mqtt-sub-estop",
    "type": "mqtt in",
    "z": "flow1",
    "name": "estop",
    "topic": "motor/health/estop",
    "qos": "0",
    "datatype": "string",
    "broker": "broker1",
    "x": 160,
    "y": 240,
    "wires": [["ui-estop"]]
  },
  {
    "id": "mqtt-cmd",
    "type": "mqtt out",
    "z": "flow1",
    "name": "cmd",
    "topic": "motor/health/cmd",
    "qos": "0",
    "retain": "false",
    "broker": "broker1",
    "x": 540,
    "y": 360,
    "wires": []
  },
  {
    "id": "uf-state",
    "type": "function",
    "z": "flow1",
    "name": "split state",
    "func": "var c = msg.payload;\nvar cls = c.class || 'UNKNOWN';\nvar colour = 'grey';\nif (cls === 'HEALTHY') colour = 'green';\nelse if (cls === 'IMBALANCED') colour = 'orange';\nelse if (cls === 'FRICTION') colour = 'red';\nreturn [\n  { payload: cls },\n  { payload: c.current },\n  { payload: c.rpm },\n  { payload: c.voltage }\n];",
    "outputs": 4,
    "x": 360,
    "y": 120,
    "wires": [["ui-class"], ["ui-current"], ["ui-rpm"], ["ui-voltage"]]
  },
  {
    "id": "ui-class",
    "type": "ui_text",
    "z": "flow1",
    "group": "grp-status",
    "order": 1,
    "width": 6,
    "height": 2,
    "name": "Class",
    "label": "State",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "x": 550,
    "y": 100,
    "wires": []
  },
  {
    "id": "ui-current",
    "type": "ui_gauge",
    "z": "flow1",
    "group": "grp-telemetry",
    "order": 1,
    "width": 4,
    "height": 4,
    "name": "Current",
    "label": "Current (mA)",
    "format": "{{value}}",
    "min": 0,
    "max": "1500",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "",
    "seg2": "",
    "x": 560,
    "y": 140,
    "wires": []
  },
  {
    "id": "ui-rpm",
